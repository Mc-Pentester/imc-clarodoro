# IMC-Clarodoro - Environment Configuration Example
# ARCH-01-PHP - Foundation
#
# Ce fichier est un modèle uniquement.
# Copiez-le en .env et ajustez les valeurs pour votre environnement.
# NE PAS commettre de vraies informations sensibles.

# Application
APP_ENV=development
APP_URL=http://localhost

# Session
SESSION_NAME=imc_clarodoro_session

# Database PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=imc_clarodoro
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
